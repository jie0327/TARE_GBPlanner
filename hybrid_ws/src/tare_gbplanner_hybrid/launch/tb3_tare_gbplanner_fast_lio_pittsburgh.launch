<launch>
  <!--
    Stress scenario for the adaptive TARE + official GBPlanner2 supervisor.
    The mine mesh is the official GBPlanner asset; TB3, Mid-360, FAST-LIO2,
    TARE and the hybrid supervisor remain the same as the validated cluttered
    garage chain. The original launch is not changed by this file.
  -->
  <arg name="gazebo_gui" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="slam_rviz" default="true"/>
  <arg name="slam_rviz_config"
       default="$(find tare_gbplanner_hybrid)/config/fast_lio_mapping_hybrid.rviz"/>
  <arg name="twoWayDrive" default="false"/>
  <!-- Pittsburgh contains sloped branches with more than 1 m elevation
       change; ground TARE's flat-world keypose gate would disconnect them. -->
  <arg name="tare_allow_vertical_edge" default="true"/>
  <arg name="maxSpeed" default="1.0"/>
  <arg name="autonomySpeed" default="0.6"/>
  <arg name="vehicleX" default="0.0"/>
  <arg name="vehicleY" default="0.0"/>
  <!-- The TB3 settles at z≈0.17 m on the mine floor.  Starting at 0.5 m
       makes it free-fall during FAST-LIO IMU initialization, which can
       corrupt gravity estimation and send the pose estimate to infinity. -->
  <arg name="vehicleZ" default="0.2"/>
  <arg name="vehicleYaw" default="0.0"/>
  <arg name="sensor_profile" default="mid360"/>
  <!-- In FAST-LIO's map frame the mine cloud extends below z=0.  A
       garage-style absolute z>=0 filter hides newly explored tunnel points. -->
  <arg name="fast_lio_viz_min_z" default="-5.0"/>
  <arg name="gbplanner_config_file"
       default="$(find gbplanner)/config/smb/gbplanner_config.yaml"/>
  <arg name="gbplanner_models"
       default="/opt/gbplanner_ws/src/exploration/gbplanner_ros/planner_gazebo_sim/models"/>

  <!-- Resolve model://pittsburgh_mine from the official GBPlanner checkout. -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(arg gbplanner_models):$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(find tare_gbplanner_hybrid)/launch/tb3_tare_gbplanner_fast_lio_cluttered.launch">
    <arg name="world_file"
         value="$(find tare_gbplanner_hybrid)/worlds/pittsburgh_mine_clean.world"/>
    <arg name="scenario" value="tunnel"/>
    <arg name="vehicleX" value="$(arg vehicleX)"/>
    <arg name="vehicleY" value="$(arg vehicleY)"/>
    <arg name="vehicleZ" value="$(arg vehicleZ)"/>
    <arg name="vehicleYaw" value="$(arg vehicleYaw)"/>
    <arg name="sensor_profile" value="$(arg sensor_profile)"/>
    <arg name="fast_lio_viz_min_z" value="$(arg fast_lio_viz_min_z)"/>
    <arg name="gazebo_gui" value="$(arg gazebo_gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="slam_rviz" value="$(arg slam_rviz)"/>
    <arg name="slam_rviz_config" value="$(arg slam_rviz_config)"/>
    <arg name="twoWayDrive" value="$(arg twoWayDrive)"/>
    <arg name="tare_allow_vertical_edge" value="$(arg tare_allow_vertical_edge)"/>
    <arg name="maxSpeed" value="$(arg maxSpeed)"/>
    <arg name="autonomySpeed" value="$(arg autonomySpeed)"/>
    <arg name="gbplanner_config_file" value="$(arg gbplanner_config_file)"/>
  </include>
</launch>
