<launch>
  <!-- Experimental chain. The original tb3_tare_fast_lio_cluttered.launch is
       not included or modified at runtime and remains independently usable. -->
  <arg name="gazebo_gui" default="false"/>
  <arg name="world_file"
       default="$(find vehicle_simulator)/world/garage_cluttered.world"/>
  <arg name="scenario" default="garage"/>
  <arg name="vehicleX" default="0.0"/>
  <arg name="vehicleY" default="0.0"/>
  <arg name="vehicleZ" default="0.0"/>
  <arg name="vehicleYaw" default="0.0"/>
  <arg name="sensor_profile" default="mid360"/>
  <arg name="fast_lio_viz_min_z" default="0.0"/>
  <arg name="rviz" default="false"/>
  <arg name="slam_rviz" default="true"/>
  <arg name="slam_rviz_config"
       default="$(find tare_gbplanner_hybrid)/config/fast_lio_mapping_hybrid.rviz"/>
  <arg name="twoWayDrive" default="false"/>
  <arg name="maxSpeed" default="1.0"/>
  <arg name="autonomySpeed" default="0.6"/>
  <arg name="gbplanner_config_file"
       default="$(find gbplanner)/config/smb/gbplanner_config.yaml"/>

  <include file="$(find tb3_tare_sim)/launch/tb3_tare_fast_lio.launch">
    <arg name="world_name" value="garage_cluttered"/>
    <arg name="world_file" value="$(arg world_file)"/>
    <arg name="scenario" value="$(arg scenario)"/>
    <arg name="vehicleX" value="$(arg vehicleX)"/>
    <arg name="vehicleY" value="$(arg vehicleY)"/>
    <arg name="vehicleZ" value="$(arg vehicleZ)"/>
    <arg name="vehicleYaw" value="$(arg vehicleYaw)"/>
    <arg name="sensor_profile" value="$(arg sensor_profile)"/>
    <arg name="fast_lio_viz_min_z" value="$(arg fast_lio_viz_min_z)"/>
    <arg name="gazebo_gui" value="$(arg gazebo_gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="slam_rviz" value="$(arg slam_rviz)"/>
    <arg name="slam_rviz_config" value="$(arg slam_rviz_config)"/>
    <!-- Suppress the adapter's automatic start. The RViz panel publishes the
         real /start_exploration command when the operator is ready. -->
    <arg name="adapter_start_topic" value="/hybrid/adapter_start"/>
    <arg name="twoWayDrive" value="$(arg twoWayDrive)"/>
    <arg name="maxSpeed" value="$(arg maxSpeed)"/>
    <arg name="autonomySpeed" value="$(arg autonomySpeed)"/>
    <arg name="tare_waypoint_topic" value="/hybrid/tare_waypoint"/>
  </include>

  <!-- Official GBPlanner2 node: TSDF mapping, random geometric graph and
       volumetric information gain all remain in the upstream implementation. -->
  <node pkg="gbplanner" type="gbplanner_node" name="gbplanner_node"
        output="screen">
    <remap from="odometry" to="/state_estimation"/>
    <remap from="/pointcloud" to="/velodyne_points_fast_lio"/>
    <rosparam command="load" file="$(arg gbplanner_config_file)"/>
    <rosparam command="load"
              file="$(find tare_gbplanner_hybrid)/config/gbplanner_tb3_mid360.yaml"/>
    <rosparam command="load"
              file="$(find tare_gbplanner_hybrid)/config/voxblox_tb3_mid360.yaml"/>
  </node>

  <node pkg="tare_gbplanner_hybrid" type="hybrid_supervisor.py"
        name="hybrid_supervisor" output="screen" required="true">
    <rosparam command="load"
              file="$(find tare_gbplanner_hybrid)/config/hybrid_policy.yaml"/>
  </node>
</launch>
